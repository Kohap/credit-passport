# === Ethereum Sepolia (source) ===
# Public RPC or your Alchemy/Infura URL — never commit a paid key
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Required — hex private key of the funded deployer (with 0x prefix)
SEPOLIA_PRIVATE_KEY=0xREPLACE_ME
# Hardened v2 testnet deployment (2026-09-08)
SEPOLIA_MOCK_USD=0x3937cFf0385AF9aAA25212432f030Ddbb1B98798
SEPOLIA_MOCK_MARKET=0x697CAf8096Bc604048C0d0CA0Dd587A509108783

# === Creditcoin CC3 Testnet (destination) ===
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
