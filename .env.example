# === Ethereum Sepolia (source) ===
# Public RPC or your Alchemy/Infura URL — never commit a paid key
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Required — hex private key of the funded deployer (with 0x prefix)
SEPOLIA_PRIVATE_KEY=0xREPLACE_ME
# Live demo deploy (2026-09)
SEPOLIA_MOCK_USD=0x5D695DD7bd61D22731973F32e84c8D797FEed701
SEPOLIA_MOCK_MARKET=0xEd2a52496044771bE1a3583f2d7061da33427a6a

# === Creditcoin CC3 Testnet (destination) ===
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
CREDITCOIN_WS_URL=wss://rpc.cc3-testnet.creditcoin.network
# Required — same key as Sepolia for the demo
CREDITCOIN_PRIVATE_KEY=0xREPLACE_ME
CREDITCOIN_CHAIN_ID=102031
SEPOLIA_CHAIN_KEY=1
PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network
PROOF_BUILDER_URL_FALLBACK=https://proof-gen-api.cc3-testnet.creditcoin.network

# Live demo deploy (2026-09)
CREDITCOIN_PASSPORT_ASC=0xc5c9B5A4842B20D945aAD6824A58Afdbb78fecbb
